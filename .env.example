# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic API key (server-side only; never exposed to the browser).
ANTHROPIC_API_KEY=

# Claude model id used for the agent loop, schedule extraction and drafting.
# Example: claude-opus-5-5 (most capable) or claude-sonnet-5-5 (faster, cheaper).
ANTHROPIC_MODEL=claude-opus-5-5
